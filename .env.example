# Required in production: signs the usage/plan cookie. Use a long random string.
APP_SECRET=change-me-to-a-long-random-string

# Optional: enables the Deep Scan engine (Claude). Without it, the statistical engine is used alone.
ANTHROPIC_API_KEY=

# Optional: plan granted to visitors with no paid plan cookie (free | starter | pro | team).
# Handy for local demos of paid features. Leave as "free" in production.
DEFAULT_PLAN=free

# Public URL of the app (used for Stripe redirects)
APP_URL=http://localhost:3000

# Optional: Stripe billing. Create recurring prices in Stripe and paste their IDs.
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=

# Optional: comma-separated keys accepted by the public API (/api/v1/detect)
API_KEYS=
